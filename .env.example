# Database
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true&connection_limit=1&pool_timeout=20"
DIRECT_URL="postgresql://user:password@host:5432/dbname"
# Prisma shadow database (used when creating dev migrations)
SHADOW_DATABASE_URL="postgresql://user:password@host:5432/prisma_shadow"

# Canonical public site URL (used for SEO: sitemap.xml, robots.txt, Open Graph, metadataBase)
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Better Auth
BETTER_AUTH_URL="https://your-domain.com"
NEXT_PUBLIC_BETTER_AUTH_URL="https://your-domain.com"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MUST be ≥32 characters. App will refuse to start if too short.
BETTER_AUTH_SECRET="your-secret-key-min-32-chars"

# Trusted origins (comma-separated) for CORS — production domain + any staging
TRUSTED_ORIGINS="https://your-domain.com,https://staging.your-domain.com"

# Trusted proxy hops for x-forwarded-for parsing (rate limiter IP extraction).
# Set to 1 for Vercel (default). Set to 0 for standalone/self-hosted where
# there is no trusted reverse proxy — all spoofable requests will share one
# rate-limit bucket ("unknown").
TRUSTED_PROXY_HOPS="1"

# Rate limiting (optional, defaults to 100)
AUTH_RATE_LIMIT_MAX="100"
# Max email/password sign-in attempts per IP per 15 min (defaults to 5).
# Raise only for dev/test (e.g. E2E suites log in repeatedly from localhost).
AUTH_SIGNIN_RATE_LIMIT_MAX="5"

# Supabase (for file storage only, NOT auth)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Resend (transactional emails: password reset, verification, newsletters)
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY="re_your-api-key-here"

# Razorpay (payment processing)
# Get your keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_your-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your-key-id"
# Webhook secret from https://dashboard.razorpay.com/app/webhooks
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# SMTP (optional fallback — settings page uses DB values first)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SENDER_NAME="NGO Skill Coordinator"
SMTP_SENDER_EMAIL="coordinator@compassionglobal.org"

# Cloudflare Turnstile (bot protection on contact form)
# Get your keys at https://dash.cloudflare.com/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Password for member accounts created by prisma/seed.ts and prisma/seed-certificates.ts (hard-required, no default)
MEMBER_PASSWORD="replace-with-real-member-password"

# Playwright E2E test credentials (dev-only; must match the DB test users).
# Sync test-user passwords with:
#   ADMIN_PASSWORD=<pw> TEST_MEMBER_PASSWORD=<pw> npx tsx scripts/update-test-passwords.ts
E2E_ADMIN_EMAIL="admin@compassionglobal.org"
E2E_ADMIN_PASSWORD="replace-with-real-admin-password"
E2E_MEMBER_EMAIL="test.member@example.com"
E2E_MEMBER_PASSWORD="replace-with-real-member-password"
