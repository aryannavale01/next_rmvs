# Database
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true&connection_limit=1&pool_timeout=20"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# Better Auth
BETTER_AUTH_URL="https://your-domain.com"
NEXT_PUBLIC_BETTER_AUTH_URL="https://your-domain.com"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MUST be ≥32 characters. App will refuse to start if too short.
BETTER_AUTH_SECRET="your-secret-key-min-32-chars"

# Trusted origins (comma-separated) for CORS — production domain + any staging
TRUSTED_ORIGINS="https://your-domain.com,https://staging.your-domain.com"

# Rate limiting (optional, defaults to 100)
AUTH_RATE_LIMIT_MAX="100"
# Max email/password sign-in attempts per IP per 15 min (defaults to 5).
# Raise only for dev/test (e.g. E2E suites log in repeatedly from localhost).
AUTH_SIGNIN_RATE_LIMIT_MAX="5"

# Supabase (for file storage only, NOT auth)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Playwright E2E test credentials (dev-only; must match the DB test users).
# Sync test-user passwords with:
#   ADMIN_PASSWORD=<pw> TEST_MEMBER_PASSWORD=<pw> npx tsx scripts/update-test-passwords.ts
E2E_ADMIN_EMAIL="admin@compassionglobal.org"
E2E_ADMIN_PASSWORD="replace-with-real-admin-password"
E2E_MEMBER_EMAIL="test.member@example.com"
E2E_MEMBER_PASSWORD="replace-with-real-member-password"
