  profileId   String        @map("profile_id")
  courseId    String?       @map("course_id")
  batch       String?
  requestDate DateTime      @default(now()) @map("request_date")
  status      RequestStatus @default(pending)
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")

  // Relations
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  course  Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@map("certificate_requests")
}

// -------------------------------------------------------------
// GROUP 3: TEACHERS (3 models)
// -------------------------------------------------------------

model Teacher {
  id              String        @id @default(uuid())
  fullName        String        @map("full_name")
  profilePhoto    String?       @map("profile_photo")
  designation     String
  qualification   String?
  specializations String[]      @default([])
  experienceYears Int?          @map("experience_years")
  email           String
  mobile          String
  village         String?
  taluka          String?
  district        String?
  state           String        @default("Maharashtra")
  pincode         String?
  status          TeacherStatus @default(active)
  teacherType     TeacherType   @default(trainer) @map("teacher_type")
  joinedDate      DateTime      @map("joined_date") @db.Date
  lastUpdated     DateTime      @default(now()) @map("last_updated")
  aadhaar         String?
  pan             String?
  bankAccount     String?       @map("bank_account")
  totalStudents   Int           @default(0) @map("total_students")
  certifications  Int           @default(0)
  rating          Decimal?      @default(0.0) @db.Decimal(3, 1)
  bio             String?
  createdAt       DateTime      @default(now()) @map("created_at")

  // Relations
  documents     TeacherDocument[]
  courses       TeacherCourse[]
  taughtCourses Course[]

  @@index([status], map: "idx_teachers_status")
  @@index([teacherType], map: "idx_teachers_type")
  @@map("teachers")
}

model TeacherDocument {
  id           String         @id @default(uuid())
  teacherId    String         @map("teacher_id")
  type         String
  label        String
  status       DocumentStatus @default(not_uploaded)
  uploadedDate DateTime?      @map("uploaded_date")
  createdAt    DateTime       @default(now()) @map("created_at")

  // Relations
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId], map: "idx_teacher_documents_teacher")
  @@map("teacher_documents")
}

model TeacherCourse {
  id             String              @id @default(uuid())
  teacherId      String              @map("teacher_id")
  courseId       String              @map("course_id")
  batch          String?
  startDate      DateTime?           @map("start_date") @db.Date
  endDate        DateTime?           @map("end_date") @db.Date
  totalStudents  Int                 @default(0) @map("total_students")
  completionRate Int                 @default(0) @map("completion_rate")
  status         TeacherCourseStatus @default(ongoing)
  createdAt      DateTime            @default(now()) @map("created_at")

  // Relations
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([teacherId], map: "idx_teacher_courses_teacher")
  @@index([courseId], map: "idx_teacher_courses_course")
  @@map("teacher_courses")
}

// -------------------------------------------------------------
// GROUP 4: CMS / PUBLIC CONTENT (12 models)
// -------------------------------------------------------------

model Program {
  id          String           @id @default(uuid())
  title       String
  category    String
  description String
  goal        Decimal?         @default(0) @db.Decimal(12, 2)
  raised      Decimal?         @default(0) @db.Decimal(12, 2)
  image       String?
  isStrategic Boolean          @default(false) @map("is_strategic")
  visibility  CourseVisibility @default(both)
  status      ContentStatus    @default(active)
  deletedAt   DateTime?        @map("deleted_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("programs")
}

model Leader {
  id         String       @id @default(uuid())
  name       String
  role       String
  status     LeaderStatus @default(active)
  image      String?
  department String?
  bio        String?
  quote      String?      @db.Text
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@map("leaders")
}

model GalleryItem {
  id          String        @id @default(uuid())
  title       String
  category    String
  image       String?
  description String?
  location    String?
  loggedDate  DateTime?     @map("logged_date") @db.Date
  isVideo     Boolean       @default(false) @map("is_video")
  status      ContentStatus @default(active)
  deletedAt   DateTime?     @map("deleted_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("gallery_items")
}

model BlogPost {
  id          String         @id @default(uuid())
  title       String
  status      BlogPostStatus @default(published)
  category    String?
  description String?
  content     String?
  readTime    String?        @map("read_time")
  date        DateTime?      @db.Date
  image       String?
  author      String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@map("blog_posts")
}

model Newsletter {
  id        String        @id @default(uuid())
  title     String
  body      String?
  date      DateTime?     @db.Date
  readTime  String?       @map("read_time")
  image     String?
  fileUrl   String?       @map("file_url")
  sentAt    DateTime?     @map("sent_at")
  sentCount Int?          @map("sent_count")
  status    ContentStatus @default(active)
  deletedAt DateTime?     @map("deleted_at")
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("newsletters")
}

model Location {
  id             String        @id @default(uuid())
  name           String
  location       String?
  type           LocationType  @default(office)
  coordinator    String?
  staffCount     Int?          @map("staff_count")
  activePrograms String[]      @default([]) @map("active_programs")
  contactEmail   String?       @map("contact_email")
  phone          String?
  address        String?
  coordinates    String?
  description    String?
  status         ContentStatus @default(active)
  deletedAt      DateTime?     @map("deleted_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("locations")
}

model ContactInfo {
  id        String   @id @default(uuid())
  email     String
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  socialLinks SocialLink[]

  @@map("contact_info")
}

model SocialLink {
  id            String   @id @default(uuid())
  contactInfoId String?  @map("contact_info_id")
  label         String
  icon          String?
  href          String
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  contactInfo ContactInfo? @relation(fields: [contactInfoId], references: [id], onDelete: Cascade)

  @@map("social_links")
}

model Testimonial {
  id        String        @id @default(uuid())
  profileId String?       @map("profile_id")
  courseId  String?       @map("course_id")
  initials  String?
  name      String
  role      String?
  quote     String
  rating    Int           @default(5)
  avatarUrl String?       @map("avatar_url")
  status    ContentStatus @default(active)
  deletedAt DateTime?     @map("deleted_at")
  createdAt DateTime      @default(now()) @map("created_at")

  // Relations
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId], map: "idx_testimonials_course")
  @@index([profileId], map: "idx_testimonials_profile")
  @@map("testimonials")
}

model Milestone {
  id          String        @id @default(uuid())
  year        Int
  title       String
  description String?
  status      ContentStatus @default(active)
  deletedAt   DateTime?     @map("deleted_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@map("milestones")
}

model Scheme {
  id          String    @id @default(uuid())
  title       String
  description String?
  icon        String    @default("BookOpen")
  category    String?
  date        DateTime? @db.Date
  link        String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("schemes")
}

model Partner {
  id        String        @id @default(uuid())
  name      String
  icon      String        @default("HeartHandshake")
  status    ContentStatus @default(active)
  deletedAt DateTime?     @map("deleted_at")
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("partners")
}

// -------------------------------------------------------------
// GROUP 5: BUSINESS LOGIC (4 models)
// -------------------------------------------------------------

model Coupon {
  id            String        @id @default(uuid())
  code          String        @unique
  courseId      String?       @map("course_id")
  isActive      Boolean       @default(true) @map("is_active")
  expiresAt     DateTime?     @map("expires_at")
  validFrom     DateTime?     @map("valid_from")
  maxUses       Int?          @map("max_uses")
  usedCount     Int           @default(0) @map("used_count")
  perUserLimit  Int?          @map("per_user_limit")
  discountType  DiscountType  @default(percentage) @map("discount_type")
  discountValue Decimal?      @default(0) @map("discount_value") @db.Decimal(10, 2)
  minAmount     Decimal?      @map("min_amount") @db.Decimal(10, 2)
  description   String?
  status        ContentStatus @default(active)
  deletedAt     DateTime?     @map("deleted_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  course      Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  redemptions CouponRedemption[]

  @@index([courseId], map: "idx_coupons_course")
  @@map("coupons")
}

model CouponRedemption {
  id                  String   @id @default(uuid())
  couponId            String   @map("coupon_id")
  userId              String   @map("user_id")
  courseApplicationId String?  @map("course_application_id")
  redeemedAt          DateTime @default(now()) @map("redeemed_at")

  // Relations
  coupon            Coupon             @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user              Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseApplication CourseApplication? @relation(fields: [courseApplicationId], references: [id], onDelete: SetNull)

  @@unique([couponId, userId, courseApplicationId])
  @@index([userId], map: "idx_coupon_redemptions_user")
  @@index([courseApplicationId], map: "idx_coupon_redemptions_application")
  @@map("coupon_redemptions")
}

model Notification {
  id          String   @id @default(uuid())
  profileId   String   @map("profile_id")
  icon        String   @default("Bell")
  title       String
  description String?
  type        String?
  timestamp   DateTime @default(now())
  read        Boolean  @default(false)
  link        String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId], map: "idx_notifications_profile")
  @@index([read], map: "idx_notifications_read")
  @@map("notifications")
}

model Activity {
  id          String   @id @default(uuid())
  profileId   String?  @map("profile_id")
  icon        String   @default("Activity")
  title       String
  description String?
  timestamp   DateTime @default(now())
  category    String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId], map: "idx_activities_profile")
  @@map("activities")
}

// -------------------------------------------------------------
// GROUP 6: ADMIN / SYSTEM (3 models)
// -------------------------------------------------------------

/// Auth audit log — tracks login, password change, step-up, and TOTP events
model AuthActivityLog {
  id        String   @id @default(uuid())
  userId    String?  @map("userId")
  action    String
  metadata  String?
  ip        String?
  createdAt DateTime @default(now()) @map("createdAt")

  user user? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], map: "idx_auth_activity_log_user_time")
  @@index([action, createdAt], map: "idx_auth_activity_log_action_time")
  @@map("AuthActivityLog")
}

model ActivityLog {
  id          String   @id @default(uuid())
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  action      String
  description String?
  timestamp   DateTime @default(now())
  performedBy String?  @map("performed_by")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId], map: "idx_activity_log_entity")
  @@map("activity_log")
}

model Setting {
  id        String   @id @default(uuid())
  category  String
  key       String
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([category, key])
  @@index([category], map: "idx_settings_category")
  @@map("settings")
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  label     String
  category  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category], map: "idx_site_settings_category")
  @@map("site_settings")
}

// -------------------------------------------------------------
// GROUP 7: COMPLIANCE / ORG DOCUMENTS
// -------------------------------------------------------------

enum OrgDocumentType {
  NGO_REGISTRATION_CERTIFICATE
  PAN_CARD
  TAN_CARD
  NITI_AAYOG_REGISTRATION
  CSR1
  ANNUAL_REPORT
  WORK_ORDER
  ORG_PROFILE
  CERTIFICATE_12A
  CERTIFICATE_80G

  @@map("org_document_type")
}

/// Organisation-level compliance documents (certificates, annual reports, etc.)
model OrgDocument {
  id           String          @id @default(uuid())
  type         OrgDocumentType
  title        String
  description  String?         @db.Text
  fileUrl      String?         @map("file_url")
  storagePath  String?         @map("storage_path")
  mimeType     String?         @map("mime_type")
  fileSize     Int?            @map("file_size")
  year         Int?
  isPublic     Boolean         @default(true) @map("is_public")
  displayOrder Int             @default(0) @map("display_order")
  isActive     Boolean         @default(true) @map("is_active")
  uploadedBy   String?         @map("uploaded_by")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@index([type], map: "idx_org_documents_type")
  @@index([isPublic, isActive], map: "idx_org_documents_public")
  @@index([displayOrder], map: "idx_org_documents_order")
  @@map("org_documents")
}

model BroadcastNotification {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String   @default("Bell")
  target      String   @default("All Members")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt], map: "idx_broadcast_notifications_created")
  @@map("broadcast_notifications")
}

// -------------------------------------------------------------
// GROUP 9: PUBLIC FORMS — DONATIONS
// -------------------------------------------------------------

model Donation {
  id                String    @id @default(uuid())
  donorName         String    @map("donor_name")
  donorEmail        String    @map("donor_email")
  donorPhone        String?   @map("donor_phone")
  amount            Float
  currency          String    @default("INR")
  frequency         String    @default("one-time")
  receiptId         String?   @unique @map("receipt_id")
  status            String    @default("pending")
  razorpayOrderId   String?   @unique @map("razorpay_order_id")
  razorpayPaymentId String?   @unique @map("razorpay_payment_id")
  razorpaySignature String?   @map("razorpay_signature")
  paymentMethod     String?   @map("payment_method")
  failureReason     String?   @map("failure_reason")
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(3)
  message           String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([donorEmail], map: "idx_donations_donor_email")
  @@index([status], map: "idx_donations_status")
  @@index([razorpayOrderId], map: "idx_donations_razorpay_order")
  @@index([createdAt], map: "idx_donations_created")
  @@map("donations")
}

// -------------------------------------------------------------
// GROUP 10: NEWSLETTER SUBSCRIBERS & COURSE ENROLLMENTS (PUBLIC)
// -------------------------------------------------------------

model NewsletterSubscriber {
  id             String    @id @default(uuid())
  email          String    @unique
  source         String    @default("footer")
  unsubscribed   Boolean   @default(false)
  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([email], map: "idx_newsletter_subscribers_email")
  @@map("newsletter_subscribers")
}

// -------------------------------------------------------------
// GROUP 11: RATE LIMITING (infrastructure)
// -------------------------------------------------------------

model RateLimitEntry {
  id        String   @id @default(uuid())
  key       String   @unique
  count     Int      @default(1)
  windowEnd DateTime @map("window_end")

  @@index([windowEnd], map: "idx_rate_limit_window_end")
  @@map("rate_limit_entries")
}
