model Course {
  id                 String           @id @default(uuid())
  title              String
  slug               String           @unique
  category           CourseCategory
  level              CourseLevel      @default(beginner)
  description        String
  image              String?
  duration           String
  price              Decimal?         @default(0) @db.Decimal(10, 2)
  mode               TrainingMode     @default(online)
  location           String?
  startDate          DateTime?        @map("start_date") @db.Date
  endDate            DateTime?        @map("end_date") @db.Date
  seatsTotal         Int?             @map("seats_total")
  seatsAvailable     Int?             @map("seats_available")
  teacherId          String?          @map("teacher_id")
  instructorName     String           @map("instructor_name")
  instructorRole     String?          @map("instructor_role")
  instructorImage    String?          @map("instructor_image")
  benefits           String[]         @default([])
  eligibility        String[]         @default([])
  requiredDocuments  String[]         @default([]) @map("required_documents")
  visibility         CourseVisibility @default(programs)
  accessCodeRequired Boolean          @default(false) @map("access_code_required")
  autoApprove        Boolean          @default(false) @map("auto_approve")
  currency           String           @default("INR")
  status             CourseStatus     @default(active)
  metaDescription    String?          @map("meta_description")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  // Relations
  teacher              Teacher?              @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  applications         CourseApplication[]
  enrollments          CourseEnrollment[]
  syllabus             CourseSyllabus[]
  fieldConfigs         CourseFieldConfig[]
  certificates         Certificate[]
  certificateTemplates CertificateTemplate[]
  certificateRequests  CertificateRequest[]
  coupons              Coupon[]
  testimonials         Testimonial[]
  teacherCourses       TeacherCourse[]

  @@index([slug], map: "idx_courses_slug")
  @@index([category], map: "idx_courses_category")
  @@index([visibility], map: "idx_courses_visibility")
  @@index([status], map: "idx_courses_status")
  @@index([teacherId], map: "idx_courses_teacher_id")
  @@map("courses")
}

model CourseApplication {
  id              String            @id @default(uuid())
  profileId       String            @map("profile_id")
  courseId        String            @map("course_id")
  appliedDate     DateTime          @default(now()) @map("applied_date")
  status          ApplicationStatus @default(pending)
  hasTestimonial  Boolean           @default(false) @map("has_testimonial")
  notes           String?
  couponApplied   Boolean           @default(false) @map("coupon_applied")
  amountDue       Decimal?          @default(0) @map("amount_due") @db.Decimal(10, 2)
  amountPaid      Decimal?          @default(0) @map("amount_paid") @db.Decimal(10, 2)
  paymentStatus   PaymentStatus     @default(pending) @map("payment_status")
  documents       Json?
  reviewedBy      String?           @map("reviewed_by")
  reviewedAt      DateTime?         @map("reviewed_at")
  rejectionReason String?           @map("rejection_reason")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  // Relations
  profile           Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  course            Course             @relation(fields: [courseId], references: [id], onDelete: Restrict)
  couponRedemptions CouponRedemption[]

  @@unique([profileId, courseId])
  @@index([profileId], map: "idx_course_applications_profile")
  @@index([courseId], map: "idx_course_applications_course")
  @@index([status], map: "idx_course_applications_status")
  @@map("course_applications")
}

model CourseEnrollment {
  id                   String           @id @default(uuid())
  profileId            String           @map("profile_id")
  courseId             String           @map("course_id")
  batch                String?
  trainer              String?
