// =============================================================
// COMPASSIONGLOBAL / RMVS NGO ERP — COMPLETE PRODUCTION PRISMA SCHEMA
// Generated: 2026-07-19
// Maps 1:1 to full_schema_production.sql
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// =============================================================
// BETTER AUTH TABLES (4 core models)
// Managed via Prisma migrations, NOT Better Auth auto-migration
// Field definitions match full_schema_production.sql exactly
// =============================================================

enum BA_Role {
  MEMBER
  ADMIN

  @@map("Role")
}

/// Better Auth — Authentication identity
model user {
  id                 String    @id
  email              String    @unique
  emailVerified      Boolean   @default(false) @map("emailVerified")
  name               String?
  image              String?
  role               BA_Role   @default(MEMBER)
  mustChangePassword Boolean   @default(false) @map("mustChangePassword")
  twoFactorEnabled   Boolean   @default(false) @map("twoFactorEnabled")
  lastLoginAt        DateTime? @map("lastLoginAt")
  createdAt          DateTime  @default(now()) @map("createdAt")
  updatedAt          DateTime  @updatedAt @map("updatedAt")

  sessions         session[]
  accounts         account[]
  profiles         Profile[]
  loginAttempts    loginAttempt[]
  authActivityLogs AuthActivityLog[]
  twoFactorRecords twoFactor[]
  adminOtps        AdminOtp[]

  @@map("User")
}

/// Better Auth — Active sessions
model session {
  id               String    @id
  token            String    @unique
  userId           String    @map("userId")
  expiresAt        DateTime  @map("expiresAt")
  ipAddress        String?   @map("ipAddress")
  userAgent        String?   @map("userAgent")
  stepUpVerifiedAt DateTime? @map("stepUpVerifiedAt")
  createdAt        DateTime  @default(now()) @map("createdAt")
  updatedAt        DateTime  @updatedAt @map("updatedAt")

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Session")
}

/// Better Auth — Auth provider accounts (email/password hashed here)
model account {
  id                    String    @id
  userId                String    @map("userId")
  accountId             String    @map("accountId")
  providerId            String    @map("providerId")
  accessToken           String?   @map("accessToken")
  refreshToken          String?   @map("refreshToken")
  accessTokenExpiresAt  DateTime? @map("accessTokenExpiresAt")
  refreshTokenExpiresAt DateTime? @map("refreshTokenExpiresAt")
  scope                 String?
  idToken               String?   @map("idToken")
  password              String?
  createdAt             DateTime  @default(now()) @map("createdAt")
  updatedAt             DateTime  @updatedAt @map("updatedAt")

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Account")
}

/// Better Auth — Email verification tokens
model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expiresAt")
  createdAt  DateTime @default(now()) @map("createdAt")
  updatedAt  DateTime @updatedAt @map("updatedAt")

  @@map("Verification")
}

/// Better Auth — Two-factor authentication (TOTP)
model twoFactor {
  id                      String    @id @default(uuid())
  secret                  String
  backupCodes             String
  userId                  String    @map("userId")
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failedVerificationCount")
  lockedUntil             DateTime? @map("lockedUntil")

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_two_factor_user")
  @@map("twoFactor")
}

/// Better Auth — Login attempt tracking (used by rate limiter when storage: "database")
model loginAttempt {
  id         String   @id
  email      String?
  ip         String
  successful Boolean  @default(false)
  userId     String?  @map("userId")
  createdAt  DateTime @default(now()) @map("createdAt")

  user user? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt], map: "idx_login_attempt_email_time")
  @@index([ip, createdAt], map: "idx_login_attempt_ip_time")
  @@map("LoginAttempt")
}

// =============================================================
// Admin email OTP challenges (admin-only 2-step login)
// =============================================================
model AdminOtp {
  id         String    @id @default(dbgenerated("gen_random_uuid()"))
  userId     String    @map("userId")
  email      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user user? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, createdAt], map: "idx_admin_otp_email_time")
  @@map("AdminOtp")
}

// =============================================================
// Password-reset OTP challenges (public forgot-password flow)
// =============================================================
model PasswordResetOtp {
  id         String    @id @default(dbgenerated("gen_random_uuid()"))
  email      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt], map: "idx_pwreset_otp_email_time")
  @@map("PasswordResetOtp")
}

