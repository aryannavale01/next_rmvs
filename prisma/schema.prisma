/// User profile — linked to Better Auth User via id (FK: profiles.id → User.id, onDelete: Cascade)
model Profile {
  id                String        @id
  fullName          String        @map("full_name")
  email             String
  phone             String?
  avatarUrl         String?       @map("avatar_url")
  photoUrlHQ        String?       @map("photo_url_hq")
  photoBlurDataUrl  String?       @map("photo_blur_data_url")
  gender            Gender?
  dob               DateTime?     @db.Date
  role              UserRole      @default(member)
  aadhaarNumber     String?       @map("aadhaar_number")
  panNumber         String?       @map("pan_number")
  addressLine1      String?       @map("address_line1")
  district          String?
  state             String?
  pincode           String?
  qualification     String?
  emailVerified     Boolean       @default(false) @map("email_verified")
  phoneVerified     Boolean       @default(false) @map("phone_verified")
  profileCompletion Int           @default(0) @map("profile_completion")
  verificationScore Int           @default(0) @map("verification_score")
  status            ProfileStatus @default(active)
  registrationDate  DateTime      @default(now()) @map("registration_date")
  lastLogin         DateTime?     @map("last_login")
  assignedVolunteer String?       @map("assigned_volunteer")
  fieldOfficer      String?       @map("field_officer")
  coordinator       String?
  region            String?
  adminNotes        String?       @map("admin_notes")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Relations
  user                 user?                 @relation(fields: [id], references: [id], onDelete: Cascade)
  beneficiaryDetail    BeneficiaryDetail?
  beneficiaryAddresses BeneficiaryAddress[]
  beneficiaryDocuments BeneficiaryDocument[]
  courseApplications   CourseApplication[]
  courseEnrollments    CourseEnrollment[]
  certificates         Certificate[]
  certificateRequests  CertificateRequest[]
  notifications        Notification[]
  activities           Activity[]
  couponRedemptions    CouponRedemption[]
  testimonials         Testimonial[]

  @@index([email], map: "idx_profiles_email")
  @@index([phone], map: "idx_profiles_phone")
  @@index([role], map: "idx_profiles_role")
  @@index([status], map: "idx_profiles_status")
  @@index([registrationDate], map: "idx_profiles_registration_date")
  @@map("profiles")
}

