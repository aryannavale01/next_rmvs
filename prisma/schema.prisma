/// User profile — linked to Better Auth User via id (FK enforced at DB level, not Prisma)
model Profile {
  id                String        @id
  fullName          String        @map("full_name")
  email             String
  phone             String?
  avatarUrl         String?       @map("avatar_url")
  gender            Gender?
  dob               DateTime?     @db.Date
  role              UserRole      @default(member)
  aadhaarNumber     String?       @map("aadhaar_number")
  panNumber         String?       @map("pan_number")
  addressLine1      String?       @map("address_line1")
  district          String?
  state             String?
  pincode           String?
  qualification     String?
  emailVerified     Boolean       @default(false) @map("email_verified")
  phoneVerified     Boolean       @default(false) @map("phone_verified")
  profileCompletion Int           @default(0) @map("profile_completion")
  verificationScore Int           @default(0) @map("verification_score")
  status            ProfileStatus @default(active)
  registrationDate  DateTime      @default(now()) @map("registration_date")
  lastLogin         DateTime?     @map("last_login")
  assignedVolunteer String?       @map("assigned_volunteer")
  fieldOfficer      String?       @map("field_officer")
  coordinator       String?
  region            String?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Relations
  beneficiaryDetail    BeneficiaryDetail?
  beneficiaryAddresses BeneficiaryAddress[]
  beneficiaryDocuments BeneficiaryDocument[]
  courseApplications   CourseApplication[]
  courseEnrollments    CourseEnrollment[]
  certificates         Certificate[]
  certificateRequests  CertificateRequest[]
  notifications        Notification[]
  activities           Activity[]
  couponRedemptions    CouponRedemption[]
  testimonials         Testimonial[]

  @@index([email], map: "idx_profiles_email")
  @@index([phone], map: "idx_profiles_phone")
  @@index([role], map: "idx_profiles_role")
  @@index([status], map: "idx_profiles_status")
  @@index([registrationDate], map: "idx_profiles_registration_date")
  @@map("profiles")
}

model BeneficiaryDetail {
  id                     String          @id @default(uuid())
  profileId              String          @unique @map("profile_id")
  religion               String?
  maritalStatus          MaritalStatus?  @map("marital_status")
  occupation             Occupation?
  annualIncome           String?         @map("annual_income")
  disability             String?
  bloodGroup             String?         @map("blood_group")
  skills                 String[]        @default([])
  languages              String[]        @default([])
  emergencyContact       String?         @map("emergency_contact")
  guardian               String?
  category               SocialCategory?
  rationCard             String?         @map("ration_card")
  educationQualification Qualification?  @map("education_qualification")
  educationSchool        String?         @map("education_school")
  educationCollege       String?         @map("education_college")
  educationPassingYear   Int?            @map("education_passing_year")
  educationMarks         String?         @map("education_marks")
  tags                   String[]        @default([])
  flags                  String[]        @default([])
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  // Relations
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId], map: "idx_beneficiary_details_profile")
  @@map("beneficiary_details")
}

model BeneficiaryAddress {
  id                     String   @id @default(uuid())
  profileId              String   @map("profile_id")
